{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // No ASCII logo -- compact spec block only.
  // Key colors are ANSI indices so they follow the pywal palette kitty loads.
  "logo": {
    "type": "none",
    "padding": { "top": 1, "left": 2 }
  },

  // Alignment is done purely by key width (fastfetch emits an absolute column
  // move), so the separator is left empty to avoid double-spacing.
  "display": {
    "separator": "",
    "key": { "width": 8 }
  },

  "modules": [
    {
      "type": "title",
      "key": " ",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "─────────────────────────────"
    },
    { "type": "os",         "key": "os",     "keyColor": "blue",    "format": "{name} {arch}" },
    { "type": "kernel",     "key": "kernel", "keyColor": "blue",    "format": "{release}" },
    { "type": "wm",         "key": "wm",     "keyColor": "magenta" },
    { "type": "shell",      "key": "shell",  "keyColor": "magenta", "format": "{pretty-name} {version}" },
    { "type": "terminal",   "key": "term",   "keyColor": "magenta" },
    { "type": "uptime",     "key": "up",     "keyColor": "yellow" },
    {
      "type": "custom",
      "format": "─────────────────────────────"
    },
    { "type": "cpu",        "key": "cpu",    "keyColor": "green",   "format": "{name} ({cores-logical})" },
    { "type": "gpu",        "key": "gpu",    "keyColor": "green",   "format": "{name}" },
    { "type": "memory",     "key": "mem",    "keyColor": "green" },
    { "type": "disk",       "key": "disk",   "keyColor": "green",   "folders": "/" },
    { "type": "packages",   "key": "pkgs",   "keyColor": "cyan" },
    {
      "type": "custom",
      "format": "─────────────────────────────"
    },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" },
    "break"
  ]
}
