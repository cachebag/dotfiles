{
  "manifest_version": 3,
  "name": "Quickshell Apple Music bridge",
  "version": "1.0",
  "description": "Lets the Quickshell island control music.apple.com through the page's own MusicKit, over native messaging.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://music.apple.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://music.apple.com/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://music.apple.com/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ]
}
